import "../node_modules/@vampgg/utils/schema/pool.bop"
import "../node_modules/@vampgg/utils/schema/behavior.bop"
import "../node_modules/@vampgg/utils/schema/vec.bop"
import "./tags.bop"

// Leaf ids a BehaviorTree can reference. Codegen keys `GameConditions` and
// `GameTasks` by these, so every member must have an implementation.
enum Condition {
	PlayerNear = 1;
}

enum Task {
	Attack = 1;
}

message Entity {
	1 -> string id;
	2 -> string sk;
	3 -> Tags[] tags;
	4 -> string parent;
	5 -> string[] children;
	6 -> Pool health;
	7 -> Vec2 position;
	8 -> Vec2 velocity;
	9 -> Pool mana;
	10 -> Pool stamina;
	11 -> uint32 level;
	12 -> uint32 xp;
	13 -> uint32 faction;
	14 -> Brain brain;
	15 -> BehaviorTree behaviorTree;
}
